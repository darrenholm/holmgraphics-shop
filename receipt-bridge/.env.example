# receipt-bridge/.env  — copy to .env on Design Centre 1 and fill in.

# Long random string. The web app sends it as a Bearer token.
API_KEY=change-me-to-a-long-random-string

# Exact Windows queue name of the receipt printer.
# Run: powershell -Command "Get-Printer | Select-Object Name"
PRINTER_NAME=

# Where the browser reaches this bridge from. Add every origin that prints.
ALLOWED_ORIGINS=https://shop.holmgraphics.ca

PORT=41962
# 127.0.0.1 keeps it loopback-only (use with a Cloudflare Tunnel).
# 0.0.0.0 exposes it on the shop LAN.
BIND=127.0.0.1
